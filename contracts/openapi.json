            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/actor"
          }
        }
      },
      "SendRequestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "communication_id",
          "authority",
          "status"
        ],
        "properties": {
          "communication_id": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
          },
          "authority": {
            "$ref": "#/components/schemas/Authority"
          },
