          },
          "governing_when_ids": {
            "type": "array",
            "items": {
              "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
            }
          },
          "breaching": {
            "type": "boolean"
          }
        }
      },
      "OpenLoopsResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loops"
        ],
        "properties": {
