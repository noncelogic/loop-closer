            "enum": [
              "pending_approval",
              "enqueued"
            ],
            "description": "joe-approves-each always yields pending_approval; nothing is sent."
          }
        }
      },
      "ApproveSendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approver"
        ],
        "properties": {
          "approver": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/actor"
          }
        }
      },
      "ApproveSendResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "communication_id",
          "status",
          "ledger_event"
        ],
        "properties": {
          "communication_id": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
          },
          "status": {
            "const": "released"
          },
          "ledger_event": {
            "$ref": "#/components/schemas/LedgerEvent"
          }
        }
      },
      "HealthResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window",
          "breach_pct",
          "manual_correction_count",
          "median_open_age_seconds",
          "abandonment_count"
        ],
        "properties": {
          "window": {
            "type": "string"
          },
          "snapshot_at": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/timestamp"
          },
          "breach_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "manual_correction_count": {
            "type": "integer",
            "minimum": 0
          },
          "median_open_age_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "abandonment_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ExportBundle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "nodes",
          "edges",
          "loops",
          "ledger",
          "communications",
          "policies",
          "templates",
          "tombstones"
        ],
        "properties": {
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "schema_version",
              "exported_at",
              "scope"
            ],
            "properties": {
              "format": {
                "const": "loopcloser-export"
              },
              "schema_version": {
                "const": "v1"
              },
              "exported_at": {
                "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/timestamp"
              },
              "scope": {
                "type": "string"
              }
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edge"
            }
          },
          "loops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Loop"
            }
          },
          "ledger": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEvent"
            },
            "description": "Complete and in order; replaying it reproduces current state."
          },
          "communications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Communication"
            }
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Versioned policy records (SPEC B4)."
          },
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowTemplate"
            }
          },
          "tombstones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tombstone"
            }
          }
        }
      }
    }
  }
}
