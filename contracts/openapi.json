          "subject_ids": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/supersession.schema.json#/properties/subject_ids"
          },
          "payload": {
            "type": "object"
          },
          "actor": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/actor"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
