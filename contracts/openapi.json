            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
          },
          "provenance": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/supersession.schema.json#/$defs/provenance"
