          "via_edge_ids": {
            "type": "array",
            "items": {
              "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
            }
          }
        }
      },
      "WhatFiresNextResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effects"
        ],
        "properties": {
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FiringEffect"
            }
          }
        }
      },
      "SupersedeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
