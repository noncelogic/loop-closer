          },
          "body_pointer": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/communication.schema.json#/properties/body_pointer"
          },
          "body_hash": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/communication.schema.json#/properties/body_hash"
          },
          "loop_id": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/communication.schema.json#/properties/loop_id"
          }
        }
