        "type": "object",
        "additionalProperties": false,
        "required": [
          "when_id",
          "loop_id"
        ],
        "properties": {
          "when_id": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
          },
          "loop_id": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/_common.schema.json#/$defs/id"
          },
          "next_state": {
            "$ref": "https://loopcloser.noncelogic.invalid/schemas/v1/loop.schema.json#/$defs/loop_state"
          },
