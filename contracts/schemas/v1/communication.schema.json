{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopcloser.noncelogic.invalid/schemas/v1/communication.schema.json",
  "title": "Communication (SPEC B2.5)",
  "description": "Evidence object for communications loops; transitions into or out of waiting/chased cite one (or a gather event).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "thread_id", "channel", "direction", "participant_who_ids", "at",
    "body_pointer", "body_hash", "loop_id", "sent_under_authority"
  ],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "thread_id": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["email", "message", "other"] },
    "direction": { "enum": ["outbound", "inbound"] },
    "participant_who_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "_common.schema.json#/$defs/id" }
    },
    "at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "body_pointer": { "description": "Artifact / Original reference for the body.", "type": "string", "minLength": 1 },
    "body_hash": { "$ref": "_common.schema.json#/$defs/sha256" },
    "loop_id": { "$ref": "_common.schema.json#/$defs/id" },
    "sent_under_authority": {
      "description": "Authority in force when sent; null for inbound.",
      "oneOf": [{ "$ref": "authority.schema.json" }, { "type": "null" }]
    }
  },
  "if": { "properties": { "direction": { "const": "inbound" } }, "required": ["direction"] },
  "then": { "properties": { "sent_under_authority": { "type": "null" } } }
}
