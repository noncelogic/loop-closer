{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopcloser.noncelogic.invalid/schemas/v1/node.schema.json",
  "title": "Node (SPEC B2.1)",
  "description": "One type-space, three kinds: who, what, when.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "created_at", "status", "attributes"],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "kind": { "enum": ["who", "what", "when"] },
    "created_at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["active", "superseded", "merged", "tombstoned"] },
    "attributes": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "who" } }, "required": ["kind"] },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/who_attributes" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "what" } }, "required": ["kind"] },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/what_attributes" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "when" } }, "required": ["kind"] },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/when_attributes" } } }
    }
  ],
  "$defs": {
    "who_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who_type", "name", "contact_points", "external_ids"],
      "properties": {
        "who_type": { "enum": ["person", "agent", "system", "device", "organisation"] },
        "name": { "type": "string", "minLength": 1 },
        "contact_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "address", "valid_during"],
            "properties": {
              "channel": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "minLength": 1 },
              "valid_during": { "$ref": "_common.schema.json#/$defs/interval" }
            }
          }
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "objective_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "what_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what_type", "title"],
      "properties": {
        "what_type": { "enum": ["action", "deliverable", "artifact", "fact", "objective"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "ranker_ref": { "$ref": "_common.schema.json#/$defs/ranker_ref" },
        "target": { "$ref": "#/$defs/objective_target" },
        "current_value": { "type": ["number", "null"] },
        "revision": {
          "description": "Objective target revision; a target change is a new revision (B2.8 objective_revision), never an overwrite.",
          "type": "integer",
          "minimum": 1
        }
      },
      "if": { "properties": { "what_type": { "const": "objective" } }, "required": ["what_type"] },
      "then": { "required": ["target", "current_value", "revision"] },
      "else": { "not": { "anyOf": [{ "required": ["target"] }, { "required": ["revision"] }] } }
    },
    "when_attributes": {
      "type": "object",
      "required": ["when_type"],
      "properties": {
        "when_type": { "enum": ["event", "calendar"] }
      },
      "oneOf": [
        { "$ref": "#/$defs/event_when" },
        { "$ref": "#/$defs/calendar_when" }
      ]
    },
    "event_when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_type", "event_type", "source_binding", "fired_at", "fire_count"],
      "properties": {
        "when_type": { "const": "event" },
        "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "mechanism"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "mechanism": { "enum": ["webhook", "poll", "manual"] },
            "config": { "type": "object" }
          }
        },
        "fired_at": { "$ref": "_common.schema.json#/$defs/nullable_timestamp" },
        "fire_count": { "type": "integer", "minimum": 0 }
      }
    },
    "calendar_when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_type", "schedule", "timezone", "next_fire_at"],
      "properties": {
        "when_type": { "const": "calendar" },
        "schedule": {
          "description": "A one-off datetime or a recurrence rule (RFC 5545 RRULE).",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at"],
              "properties": { "at": { "$ref": "_common.schema.json#/$defs/timestamp" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["rrule"],
              "properties": {
                "rrule": { "type": "string", "pattern": "^(RRULE:)?FREQ=" },
                "dtstart": { "$ref": "_common.schema.json#/$defs/timestamp" }
              }
            }
          ]
        },
        "timezone": { "type": "string", "minLength": 1 },
        "next_fire_at": { "$ref": "_common.schema.json#/$defs/nullable_timestamp" }
      }
    }
  }
}
