{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopcloser.noncelogic.invalid/schemas/v1/workflow-template.schema.json",
  "title": "Workflow template (SPEC B2.7)",
  "description": "Versioned data. Workflows are template instantiation + step composition; no novel synthesis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "steps"],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "primitive": { "enum": ["gather", "update", "draft", "send", "wait", "transition"] },
    "actor_role": { "enum": ["chaser", "drafter", "sender", "system"] },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "actor_role", "params", "on_failure"],
      "properties": {
        "primitive": { "$ref": "#/$defs/primitive" },
        "actor_role": { "$ref": "#/$defs/actor_role" },
        "params": { "type": "object" },
        "on_failure": { "enum": ["fail_run", "retry", "skip", "escalate"] }
      },
      "if": { "properties": { "primitive": { "const": "send" } }, "required": ["primitive"] },
      "then": { "properties": { "actor_role": { "const": "sender" } } },
      "else": { "properties": { "actor_role": { "not": { "const": "sender" } } } }
    }
  }
}
