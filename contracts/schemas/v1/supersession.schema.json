{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopcloser.noncelogic.invalid/schemas/v1/supersession.schema.json",
  "title": "Typed supersession (SPEC B2.8)",
  "description": "Supersession is not one operation: the type is required and determines the payload. Takes immediate effect on current state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "subject_ids", "actor", "reason", "at", "payload"],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "type": { "$ref": "#/$defs/supersession_type" },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "_common.schema.json#/$defs/id" }
    },
    "actor": { "$ref": "_common.schema.json#/$defs/actor" },
    "reason": { "type": "string", "minLength": 1 },
    "at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "fact_replacement" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/fact_replacement_payload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "valid_during" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/valid_during_payload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "same_as_merge" } }, "required": ["type"] },
      "then": {
        "properties": { "subject_ids": { "minItems": 2 }, "payload": { "$ref": "#/$defs/same_as_merge_payload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "split" } }, "required": ["type"] },
      "then": {
        "properties": { "subject_ids": { "maxItems": 1 }, "payload": { "$ref": "#/$defs/split_payload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "objective_revision" } }, "required": ["type"] },
      "then": {
        "properties": { "subject_ids": { "maxItems": 1 }, "payload": { "$ref": "#/$defs/objective_revision_payload" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "loop_supersession" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/loop_supersession_payload" } } }
    }
  ],
  "$defs": {
    "supersession_type": {
      "enum": ["fact_replacement", "valid_during", "same_as_merge", "split", "objective_revision", "loop_supersession"]
    },
    "provenance": {
      "description": "Why the identity decision was made — required because a wrong merge chases the wrong person.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decided_by", "basis"],
      "properties": {
        "decided_by": { "$ref": "_common.schema.json#/$defs/actor" },
        "basis": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "_common.schema.json#/$defs/evidence" } }
      }
    },
    "fact_replacement_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement_id"],
      "properties": { "replacement_id": { "$ref": "_common.schema.json#/$defs/id" } }
    },
    "valid_during_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "interval"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value": {},
        "interval": { "$ref": "_common.schema.json#/$defs/interval" }
      }
    },
    "same_as_merge_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surviving_id", "provenance"],
      "properties": {
        "surviving_id": { "$ref": "_common.schema.json#/$defs/id" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "reverses": { "$ref": "_common.schema.json#/$defs/id" }
      }
    },
    "split_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ids", "provenance"],
      "properties": {
        "result_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "_common.schema.json#/$defs/id" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "reverses": { "$ref": "_common.schema.json#/$defs/id" }
      }
    },
    "objective_revision_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_revision", "to_revision", "diff", "surfaced_to_who_id"],
      "properties": {
        "from_revision": { "type": "integer", "minimum": 1 },
        "to_revision": { "type": "integer", "minimum": 2 },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "node.schema.json#/$defs/objective_target" },
            "after": { "$ref": "node.schema.json#/$defs/objective_target" }
          }
        },
        "surfaced_to_who_id": { "$ref": "_common.schema.json#/$defs/id" }
      }
    },
    "loop_supersession_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement_loop_id", "superseded_aspect"],
      "properties": {
        "replacement_loop_id": { "$ref": "_common.schema.json#/$defs/id" },
        "superseded_aspect": {
          "description": "What was superseded — the three are not interchangeable.",
          "enum": ["objective", "loop", "counterpart_who"]
        }
      }
    }
  }
}
