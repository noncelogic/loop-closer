{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopcloser.noncelogic.invalid/schemas/v1/ledger-event.schema.json",
  "title": "Ledger event (SPEC B2.4)",
  "description": "Append-only. Written in the same transaction as the change it records; never edited — corrections are new events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "at", "actor", "event_type", "subject_ids", "payload", "idempotency_key"],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/id" },
    "at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "actor": { "$ref": "_common.schema.json#/$defs/actor" },
    "event_type": { "$ref": "#/$defs/event_type" },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_common.schema.json#/$defs/id" }
    },
    "payload": { "type": "object" },
    "idempotency_key": {
      "description": "Set for event-driven changes: the same external event delivered twice applies once.",
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "transition" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["from_state", "to_state"],
            "properties": {
              "from_state": { "$ref": "loop.schema.json#/$defs/loop_state" },
              "to_state": { "$ref": "loop.schema.json#/$defs/loop_state" },
              "evidence": { "$ref": "_common.schema.json#/$defs/evidence" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "supersession" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["supersession_type"],
            "properties": { "supersession_type": { "$ref": "supersession.schema.json#/$defs/supersession_type" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "event_type": {
      "enum": [
        "loop_proposed", "loop_accepted", "loop_rejected", "transition", "when_fired",
        "communication_sent", "communication_received", "gather_performed", "supersession",
        "merge", "split", "manual_correction", "tombstone"
      ]
    }
  }
}
