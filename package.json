{
  "name": "loopcloser",
  "version": "0.0.0",
  "private": true,
  "description": "Loop Closer service (loopcloser): REST API + MCP adapter over a Postgres system of record.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "start": "node dist/main.js",
    "test": "node --test \"tests/**/*.test.ts\"",
    "replica:up": "docker compose up --detach --wait",
    "replica:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
